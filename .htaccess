RewriteEngine On

# ============================================================
# GAGS Foundation - Apache URL Rewriting
# Routes /api/* requests to the PHP front-controller
# Serves all other files (HTML, CSS, JS, images) directly
# ============================================================

# If the request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all /api/* requests to the PHP front-controller
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# Default: serve index.html for root
DirectoryIndex index.html
